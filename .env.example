# Copy this to .env for local dev. On Railway, set these as real environment
# variables in the service settings instead -- never commit an actual .env file.

# Same pattern as Vespermark: use DATABASE_PUBLIC_URL for anything running
# outside Railway's private network (local dev, Prisma Studio, migrations
# run from your machine). Railway's internal DATABASE_URL only works for
# the deployed service talking to its own database.
DATABASE_URL="postgresql://user:password@localhost:5432/kazii?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-real-random-secret-before-deploying"

# Stripe test-mode keys -- from the Stripe dashboard's Developers > API keys page.
STRIPE_SECRET_KEY="sk_test_..."

# From Stripe's webhook endpoint settings (or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET="whsec_..."

# Base URL of the deployed frontend -- used to build Stripe's success/cancel redirect URLs.
FRONTEND_URL="https://kaziiplus.com"

PORT=4000
NODE_ENV=development

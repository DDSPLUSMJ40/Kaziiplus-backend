// Kazii+ Backend — Database Schema
// Mirrors the account types already live in the frontend signup flow
// (Creator / Supplier / Manufacturer), plus the product + supplier data
// the Builder and Suppliers tab already render from hardcoded demo state.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CREATOR
  SUPPLIER
  MANUFACTURER
}

enum ProductStatus {
  DRAFT
  LIVE
}

enum OrderStatus {
  PENDING
  FULFILLED
  SHIPPED
}

// Only PRINTFUL is implemented (Phase 1 of the fulfillment integration
// spec). Adding a provider here is step one of onboarding it -- see
// src/fulfillment/ for the adapter that has to exist before it's usable.
enum FulfillmentProvider {
  PRINTFUL
}

enum ConnectionStatus {
  ACTIVE
  REVOKED
  ERROR
}

enum FulfillmentOrderStatus {
  PENDING
  SUBMITTED
  IN_PRODUCTION
  SHIPPED
  CANCELED
  FAILED
}

// One row per registered account, regardless of type.
// Type-specific fields live in the linked profile table.
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  accountType  AccountType
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  creatorProfile      CreatorProfile?
  supplierProfile      SupplierProfile?
  manufacturerProfile  ManufacturerProfile?

  @@map("users")
}

// Matches the Creator signup form: first name, brand name (optional)
model CreatorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  brandName      String?
  storefrontSlug String?  @unique
  followers      Int?     // populated once social-account connection is real, not demo data
  createdAt      DateTime @default(now())

  products Product[]
  orders   Order[]
  supplierConnections SupplierConnection[]

  @@map("creator_profiles")
}

// Matches the Supplier signup form: company name, product category, country
model SupplierProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  category     String
  country      String
  moqUnits     Int?
  leadTimeDays Int?
  reliability  Int      @default(85) // 0-100, seeded default until real order history accrues
  createdAt    DateTime @default(now())

  @@map("supplier_profiles")
}

// Matches the Manufacturer signup form: company name, specialty, country, MOQ, lead time
model ManufacturerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  specialty    String
  country      String
  moqUnits     Int
  leadTimeDays Int
  reliability  Int      @default(85)
  createdAt    DateTime @default(now())

  @@map("manufacturer_profiles")
}

// A creator's product — what the Builder currently only holds in browser state
model Product {
  id          String        @id @default(cuid())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name        String
  productType String        // tshirt, hoodie, mug, tote, poster -- matches Builder's PRODUCT_TYPES keys
  color       String?
  status      ProductStatus @default(DRAFT)
  price       Decimal?      @db.Decimal(10, 2)
  designJson  Json?         // layer data from the Builder (text/artwork placement)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders         Order[]
  syncedProducts SyncedProduct[]

  @@map("products")
}

model Order {
  id          String      @id @default(cuid())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  customerHandle String
  status      OrderStatus @default(PENDING)
  amount      Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())

  fulfillmentOrders FulfillmentOrder[]

  @@map("orders")
}

// Per fulfillment-integration-spec.md section 3's suggested tables --
// a creator's credentials for one provider. Tokens are encrypted at the
// application layer (src/lib/crypto.ts) before they ever reach this
// column; see that file's header for what "encrypted at rest" actually
// means here versus the KMS/Vault setup the spec describes as the
// longer-term target.
model SupplierConnection {
  id                    String              @id @default(cuid())
  creatorId             String
  creator               CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  provider              FulfillmentProvider
  encryptedAccessToken  String
  encryptedRefreshToken String?
  expiresAt             DateTime?
  connectedAt           DateTime            @default(now())
  status                ConnectionStatus    @default(ACTIVE)

  syncedProducts    SyncedProduct[]
  fulfillmentOrders FulfillmentOrder[]

  @@unique([creatorId, provider])
  @@map("supplier_connections")
}

// Caches a provider's catalog entry against the Kazii product it's
// linked to, if any -- lets the Builder show "already connected to
// Printful" without a live API call on every page load.
model SyncedProduct {
  id                String             @id @default(cuid())
  connectionId      String
  connection        SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider          FulfillmentProvider
  externalProductId String
  kaziiProductId    String?
  product           Product?           @relation(fields: [kaziiProductId], references: [id])
  cachedCatalogJson Json?
  lastSyncedAt      DateTime           @default(now())

  @@unique([connectionId, externalProductId])
  @@map("synced_products")
}

// One row per attempt to fulfill a Kazii order through a connected
// provider. providerOrderId is null until the provider's create-order
// call succeeds; status is updated by both the polling fallback and the
// webhook receiver, whichever reaches it first.
model FulfillmentOrder {
  id              String                 @id @default(cuid())
  kaziiOrderId    String
  order           Order                  @relation(fields: [kaziiOrderId], references: [id])
  connectionId    String
  connection      SupplierConnection     @relation(fields: [connectionId], references: [id])
  provider        FulfillmentProvider
  providerOrderId String?
  status          FulfillmentOrderStatus @default(PENDING)
  lastWebhookAt   DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@map("fulfillment_orders")
}
